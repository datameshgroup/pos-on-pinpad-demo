<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="@android:color/white">

    <TableLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:stretchColumns="1"
        android:padding="8dp">

        <!-- DeviceID -->
        <TableRow
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvDeviceID"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="DeviceID"
                android:textSize="16sp"
                android:paddingEnd="8dp"/>

            <EditText
                android:id="@+id/inputDeviceID"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/edit_text_border"
                android:inputType="text"
                android:padding="12dp"
                android:text="TestDevID123"
                android:textSize="16sp" />
        </TableRow>

        <!-- OperatorID -->
        <TableRow
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvOperatorID"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="OperatorID"
                android:textSize="16sp"
                android:paddingEnd="8dp"/>

            <EditText
                android:id="@+id/inputOperatorID"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/edit_text_border"
                android:inputType="text"
                android:padding="12dp"
                android:text="TestOpID123"
                android:textSize="16sp" />
        </TableRow>

        <!-- ShiftNumber -->
        <TableRow
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvShiftNumber"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ShiftNumber"
                android:textSize="16sp"
                android:paddingEnd="8dp"/>

            <EditText
                android:id="@+id/inputShiftNumber"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/edit_text_border"
                android:inputType="text"
                android:padding="12dp"
                android:text="123Shift"
                android:textSize="16sp" />
        </TableRow>

        <!-- SiteID -->
        <TableRow
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvSiteID"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SiteID"
                android:textSize="16sp"
                android:paddingEnd="8dp"/>

            <EditText
                android:id="@+id/inputSiteID"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/edit_text_border"
                android:inputType="text"
                android:padding="12dp"
                android:text="TestSitID123"
                android:textSize="16sp" />
        </TableRow>

        <!-- RegisteredIdentifier -->
        <TableRow
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvRegisteredIdentifier"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="RegIdentifier"
                android:textSize="16sp"
                android:paddingEnd="8dp"/>

            <EditText
                android:id="@+id/inputRegisteredIdentifier"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/edit_text_border"
                android:inputType="text"
                android:padding="12dp"
                android:text="Taxi123"
                android:textSize="16sp" />
        </TableRow>

    </TableLayout>

</LinearLayout>
